  "glossary": [
    {
      "term": "人工智能",
      "def": "以机器为载体展示出来的人类智能",
      "chapterId": "ch01"
    },
    {
      "term": "机器智能",
      "def": "人工智能的另一个叫法，强调载体是机器",
      "chapterId": "ch01"
    },
    {
      "term": "丘奇-图灵论题",
      "def": "凡能机械计算的东西，图灵机、递归函数、λ 演算都能计算",
      "chapterId": "ch01"
    },
    {
      "term": "领域人工智能",
      "def": "只在特定任务上达到或超过人的系统",
      "chapterId": "ch01"
    },
    {
      "term": "通用人工智能",
      "def": "能在多领域自主理解、迁移、设定目标的系统",
      "chapterId": "ch01"
    },
    {
      "term": "命题",
      "def": "能判断真假的陈述句",
      "chapterId": "ch02"
    },
    {
      "term": "实质蕴含",
      "def": "P→Q 只在 P 真 Q 假时为假",
      "chapterId": "ch02"
    },
    {
      "term": "重言式",
      "def": "在所有取值下都为真的逻辑式",
      "chapterId": "ch02"
    },
    {
      "term": "谓词逻辑",
      "def": "把句子拆成对象与性质、关系，并允许量词的一阶逻辑",
      "chapterId": "ch02"
    },
    {
      "term": "全称量词",
      "def": "符号 ∀，表示对所有对象都成立，后面接蕴含",
      "chapterId": "ch02"
    },
    {
      "term": "存在量词",
      "def": "符号 ∃，表示至少有一个对象成立，后面接合取",
      "chapterId": "ch02"
    },
    {
      "term": "归结原理",
      "def": "把推理化为子句消去操作，配合反证法使用",
      "chapterId": "ch02"
    },
    {
      "term": "知识图谱",
      "def": "用（头实体, 关系, 尾实体）三元组存储事实的网络",
      "chapterId": "ch02"
    },
    {
      "term": "路径排序推理",
      "def": "把关系路径作为特征，学习哪类路径更可能连到答案",
      "chapterId": "ch02"
    },
    {
      "term": "混杂因子",
      "def": "同时影响“选择”和“结果”的第三变量",
      "chapterId": "ch02"
    },
    {
      "term": "辛普森悖论",
      "def": "分组内都更好、合计反而更差的现象",
      "chapterId": "ch02"
    },
    {
      "term": "do 算子",
      "def": "表示强行干预的记号，区别于被动观察",
      "chapterId": "ch02"
    },
    {
      "term": "反事实",
      "def": "对已发生事件假设另一种做法会怎样的推理",
      "chapterId": "ch02"
    },
    {
      "term": "状态空间",
      "def": "由初始状态、动作、转移、目标、代价构成的问题表示",
      "chapterId": "ch03"
    },
    {
      "term": "启发函数",
      "def": "对“从当前节点到目标还需多少代价”的估计",
      "chapterId": "ch03"
    },
    {
      "term": "可采纳性",
      "def": "启发函数从不高估真实剩余代价，保证 A* 最优",
      "chapterId": "ch03"
    },
    {
      "term": "一致性",
      "def": "启发函数沿边下降不超过边代价，保证每节点只扩展一次",
      "chapterId": "ch03"
    },
    {
      "term": "Minimax",
      "def": "我方取最大、对手取最小，交替回传的对抗搜索",
      "chapterId": "ch03"
    },
    {
      "term": "Alpha-Beta 剪枝",
      "def": "利用上下界剪掉不影响决策的分支",
      "chapterId": "ch03"
    },
    {
      "term": "蒙特卡洛树搜索",
      "def": "通过反复选择、扩展、模拟、回溯估计局面胜率",
      "chapterId": "ch03"
    },
    {
      "term": "UCB",
      "def": "用“胜率 + 探索奖励”平衡利用与探索的选点公式",
      "chapterId": "ch03"
    },
    {
      "term": "监督学习",
      "def": "用带正确答案的样本学习输入到输出的映射",
      "chapterId": "ch04"
    },
    {
      "term": "泛化",
      "def": "模型在没见过的数据上的表现",
      "chapterId": "ch04"
    },
    {
      "term": "过拟合",
      "def": "模型记住训练集噪声，训练好测试差",
      "chapterId": "ch04"
    },
    {
      "term": "正则化",
      "def": "给模型加约束以抑制过拟合的手段",
      "chapterId": "ch04"
    },
    {
      "term": "最小二乘",
      "def": "使残差平方和最小的参数估计方法",
      "chapterId": "ch04"
    },
    {
      "term": "逻辑回归",
      "def": "用 Sigmoid 把线性打分压成概率的分类模型",
      "chapterId": "ch04"
    },
    {
      "term": "信息熵",
      "def": "衡量集合类别混乱程度的量，全同类时为 0",
      "chapterId": "ch04"
    },
    {
      "term": "信息增益",
      "def": "分裂前后熵的下降量，决策树据此选特征",
      "chapterId": "ch04"
    },
    {
      "term": "基尼指数",
      "def": "CART 用来衡量不纯度的指标",
      "chapterId": "ch04"
    },
    {
      "term": "线性判别分析",
      "def": "让类内散度小、类间散度大的线性投影方法",
      "chapterId": "ch04"
    },
    {
      "term": "AdaBoost",
      "def": "按错误率给弱分类器话语权、并放大错分样本权重的集成方法",
      "chapterId": "ch04"
    },
    {
      "term": "弱学习器",
      "def": "只比随机猜测略好的分类器",
      "chapterId": "ch04"
    },
    {
      "term": "支持向量",
      "def": "离分类超平面最近、决定超平面的训练点",
      "chapterId": "ch04"
    },
    {
      "term": "间隔",
      "def": "超平面到两类最近点距离之和，等于 2/‖w‖",
      "chapterId": "ch04"
    },
    {
      "term": "软间隔",
      "def": "允许部分点越界、用松弛变量与惩罚系数 C 控制",
      "chapterId": "ch04"
    },
    {
      "term": "合页损失",
      "def": "max(0, 1−y·f(x))，违反间隔才计损失",
      "chapterId": "ch04"
    },
    {
      "term": "核函数",
      "def": "等价于高维映射后内积的函数，避免显式升维",
      "chapterId": "ch04"
    },
    {
      "term": "VC 维",
      "def": "模型族能任意打散的最大点集大小，衡量复杂度",
      "chapterId": "ch04"
    },
    {
      "term": "生成式模型",
      "def": "学习联合分布 P(x,y) 再用贝叶斯反推 P(y|x)",
      "chapterId": "ch04"
    },
    {
      "term": "判别式模型",
      "def": "直接学习 P(y|x) 的模型",
      "chapterId": "ch04"
    },
    {
      "term": "K 均值聚类",
      "def": "交替分配样本与更新簇中心的聚类算法",
      "chapterId": "ch05"
    },
    {
      "term": "簇内平方和",
      "def": "每个点到所属中心的距离平方之和，K-means 的目标",
      "chapterId": "ch05"
    },
    {
      "term": "主成分分析",
      "def": "找方差最大的正交方向做线性降维",
      "chapterId": "ch05"
    },
    {
      "term": "协方差矩阵",
      "def": "描述各维度之间如何共同变化的矩阵",
      "chapterId": "ch05"
    },
    {
      "term": "奇异值分解",
      "def": "把矩阵分解为 UΣVᵀ 的方法，PCA 的免协方差实现",
      "chapterId": "ch05"
    },
    {
      "term": "特征人脸",
      "def": "SVD 得到的、看起来像模糊人脸的主方向",
      "chapterId": "ch05"
    },
    {
      "term": "潜在语义分析",
      "def": "对词-文档矩阵做低秩近似，让同义词在低维空间靠近",
      "chapterId": "ch05"
    },
    {
      "term": "期望最大化",
      "def": "交替算隐变量后验与最大化似然的参数估计方法",
      "chapterId": "ch05"
    },
    {
      "term": "隐变量",
      "def": "数据中存在但未被记录的量",
      "chapterId": "ch05"
    },
    {
      "term": "感知机",
      "def": "最早的线性神经元模型，无法解决异或",
      "chapterId": "ch06"
    },
    {
      "term": "激活函数",
      "def": "给网络引入非线性的函数，如 Sigmoid、ReLU",
      "chapterId": "ch06"
    },
    {
      "term": "反向传播",
      "def": "用链式法则从损失倒推各层参数梯度",
      "chapterId": "ch06"
    },
    {
      "term": "学习率",
      "def": "梯度下降每步移动的幅度",
      "chapterId": "ch06"
    },
    {
      "term": "卷积",
      "def": "小窗口在输入上滑动做内积的操作",
      "chapterId": "ch06"
    },
    {
      "term": "权重共享",
      "def": "同一组卷积核在全部位置复用，大幅减少参数",
      "chapterId": "ch06"
    },
    {
      "term": "池化",
      "def": "对邻域做最大或平均的降采样操作",
      "chapterId": "ch06"
    },
    {
      "term": "感受野",
      "def": "输出上一个点在输入上对应的区域",
      "chapterId": "ch06"
    },
    {
      "term": "循环神经网络",
      "def": "用隐状态在时间上传递信息的序列模型",
      "chapterId": "ch06"
    },
    {
      "term": "长短期记忆网络",
      "def": "用遗忘门、输入门、输出门缓解梯度消失的循环网络",
      "chapterId": "ch06"
    },
    {
      "term": "生成对抗网络",
      "def": "生成器与判别器互相对抗的生成模型",
      "chapterId": "ch06"
    },
    {
      "term": "对抗样本",
      "def": "加微小扰动就能让模型判错的输入",
      "chapterId": "ch06"
    },
    {
      "term": "马尔可夫决策过程",
      "def": "由状态、动作、奖励、转移、折扣构成序贯决策框架",
      "chapterId": "ch07"
    },
    {
      "term": "折扣因子",
      "def": "γ，把未来奖励按指数衰减折算到当下",
      "chapterId": "ch07"
    },
    {
      "term": "策略",
      "def": "在状态到动作之间的选择规则",
      "chapterId": "ch07"
    },
    {
      "term": "价值函数",
      "def": "从某状态出发能拿到的折扣累计奖励期望",
      "chapterId": "ch07"
    },
    {
      "term": "贝尔曼方程",
      "def": "把状态价值拆成当下奖励加折扣未来价值的递推式",
      "chapterId": "ch07"
    },
    {
      "term": "Q 学习",
      "def": "用采样替代期望、离线策略的值函数学习方法",
      "chapterId": "ch07"
    },
    {
      "term": "时序差分误差",
      "def": "实际奖励加未来估计减去当前估计的差值",
      "chapterId": "ch07"
    },
    {
      "term": "探索与利用",
      "def": "试新动作求长期收益与用当前最优求短期收益的矛盾",
      "chapterId": "ch07"
    },
    {
      "term": "ε-贪心",
      "def": "以 ε 概率随机、其余按最优选择的折中策略",
      "chapterId": "ch07"
    },
    {
      "term": "DQN",
      "def": "用深度网络近似 Q 值，配合经验回放与目标网络",
      "chapterId": "ch07"
    },
    {
      "term": "策略梯度",
      "def": "直接对策略参数求梯度、提高高回报动作概率的方法",
      "chapterId": "ch07"
    },
    {
      "term": "Actor-Critic",
      "def": "策略网络选动作、价值网络做评价的混合架构",
      "chapterId": "ch07"
    },
    {
      "term": "零和博弈",
      "def": "一方所得等于另一方所失的博弈",
      "chapterId": "ch08"
    },
    {
      "term": "纳什均衡",
      "def": "任何一方单方面改策略都不会更好的策略组合",
      "chapterId": "ch08"
    },
    {
      "term": "混合策略",
      "def": "按概率分布选择动作的策略，用于无纯策略均衡时",
      "chapterId": "ch08"
    },
